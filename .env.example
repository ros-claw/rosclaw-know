# DeepSeek API (primary LLM backend)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Extractor model — cheap and fast for bulk symptom/fix extraction
DEEPSEEK_EXTRACTOR_MODEL=deepseek-v4-flash
# Muse model — better reasoning for cross-domain analogies
DEEPSEEK_MUSE_MODEL=deepseek-v4-pro

# Wiki source (the 6097 legacy markdown pages, inherited from rosclaw-wiki)
WIKI_DIR=wiki

# Concurrency
HARVESTER_CONCURRENCY=5

# Embedding model for entity alignment (downloaded on first run, ~120MB)
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Mock mode — set to 1 to skip real LLM calls (useful for plumbing tests)
ROSCLAW_KNOW_MOCK_LLM=0

# SeekDB (optional — Know only READS for dedup + entity alignment)
SEEKDB_HOST=
SEEKDB_PORT=
