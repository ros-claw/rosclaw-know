            "type": "string"
          },
          "safety_class": {
            "const": "advisory",
            "default": "advisory",
            "title": "Safety Class",
            "type": "string"
          }
        },
        "required": [
          "action_type",
          "description",
          "rationale"
        ],
        "title": "AdviceRecommendationV2",
        "type": "object"
      },
