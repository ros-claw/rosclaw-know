  "rosclaw.how.advice.v2": {
    "$defs": {
      "AdviceRecommendationV2": {
        "additionalProperties": false,
        "properties": {
          "action_type": {
            "enum": [
              "inspect",
              "compare",
              "configure",
              "implement",
              "verify",
              "abstain"
            ],
