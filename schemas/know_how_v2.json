              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "End Line"
          },
          "evidence_id": {
            "maxLength": 240,
            "minLength": 1,
            "title": "Evidence Id",
            "type": "string"
          },
          "excerpt": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Excerpt",
            "type": "string"
          },
          "path": {
            "maxLength": 4000,
            "minLength": 1,
            "title": "Path",
            "type": "string"
          },
          "schema_version": {
            "const": "rosclaw.know.evidence_ref.v2",
            "default": "rosclaw.know.evidence_ref.v2",
            "title": "Schema Version",
            "type": "string"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Section"
          },
          "snapshot_id": {
            "maxLength": 240,
            "minLength": 1,
            "title": "Snapshot Id",
            "type": "string"
          },
          "source_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Source Id",
            "type": "string"
          },
          "start_line": {
            "anyOf": [
              {
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Start Line"
          },
